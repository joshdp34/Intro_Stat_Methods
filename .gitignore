/yt video slides/
/generated_qti/
/monty-hall/
/Intro_Stat_Methods/
/data/
/TOC.qmd
/TOC questions.qmd
/sections.xlsx
/*.csv

# ---- R / RStudio ----
.Rhistory
.RData
.Rapp.history
.Ruserdata
.Rproj.user/
rsconnect/

